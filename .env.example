# ─── Database ────────────────────────────────────────────────────────────────
# Individual credentials used by the epsca-db container
DB_NAME=epsca
DB_USER=epsca_user
DB_PASSWORD=replace-with-strong-password

# Connection string for the API service (must match the above credentials)
DATABASE_URL=postgresql://epsca_user:replace-with-strong-password@epsca-db:5432/epsca

# ─── Vector Store ────────────────────────────────────────────────────────────
# Qdrant REST API base URL (internal Docker network)
QDRANT_URL=http://epsca-qdrant:6333
# Qdrant API keys (#144/#155). Empty = keyless (local dev). For prod, generate
# each with: openssl rand -hex 32
#
# QDRANT_API_KEY — READ-WRITE. Set on the Qdrant service (compose maps it to
# QDRANT__SERVICE__API_KEY), on host-run ingestion, and in /etc/epsca/backup.env
# (backups create/delete snapshots — writes). Do NOT put this on the API.
QDRANT_API_KEY=
# QDRANT_READ_ONLY_API_KEY — READ-ONLY. Set on the Qdrant service (compose maps
# it to QDRANT__SERVICE__READ_ONLY_API_KEY) and on the API only. The API query
# path only reads, so it holds this least-privilege key — never the RW one.
QDRANT_READ_ONLY_API_KEY=

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Ollama API base URL — uses host-gateway to reach the host from inside a container
OLLAMA_URL=http://host-gateway:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Claude API ──────────────────────────────────────────────────────────────
# Anthropic API key — never commit this value
ANTHROPIC_API_KEY=sk-ant-...

# Model identifiers — configurable to allow model upgrades without code changes
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-4-6

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign and verify JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-hex-string

# JWT expiry durations
JWT_ACCESS_EXPIRY_SECONDS=900         # 15 minutes
JWT_REFRESH_EXPIRY_DAYS=7             # 7 days

# ─── Application ─────────────────────────────────────────────────────────────
# Runtime environment — controls log verbosity and error detail in responses
ENVIRONMENT=development               # development | production

# CORS allowed origins — comma-separated list
CORS_ORIGINS=http://localhost:3000

# Public origin of the Next.js app. Used to build Stripe Checkout return URLs
# (success / cancel / portal-return). Separate from CORS_ORIGINS because a
# redirect target must be exactly one origin, not an allow-list.
PUBLIC_WEB_URL=http://localhost:3000

# ─── Stripe billing (#32) ────────────────────────────────────────────────────
# TEST MODE ONLY. Live keys (sk_live_… / a live endpoint's whsec_…) must never be
# committed here — set those directly on the Dokploy service Environment tab.
#
# Leaving all of these blank is safe and supported: the billing routes return 503
# and the webhook rejects every delivery. Billing is off, not open.
#
# Secret key from https://dashboard.stripe.com/test/apikeys. Prefer a RESTRICTED
# key (rk_test_…) over the account secret key: this integration only needs write
# on Checkout Sessions, Billing Portal Sessions, Customers and Subscriptions, so
# a restricted key limits the blast radius if it leaks.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint — environment-specific, and DIFFERENT
# for dev and prod. `stripe listen` prints a local one; the prod value comes from
# the endpoint registered in the Dashboard. If this is unset the webhook fails
# CLOSED (503) rather than skipping signature verification.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…, not prod_…) for the two self-serve tiers. These differ
# between test and live mode. They are the ONLY source of the price → tier
# mapping; the API serves them to the web app at GET /billing/plans so the
# pricing page (#33) never hardcodes a second copy.
# Create as RECURRING, CAD, and TAX-EXCLUSIVE — see the tax note below.
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_PROFESSIONAL=

# Stripe Tax gate. MUST stay false until GST/HST registration (#181) is live.
# The owner is a Canadian small supplier under the CAD $30,000 threshold and is
# not registered, so charging GST/HST would be improper — and Stripe Tax bills
# 0.5%/txn to compute a 0% rate. Gates BOTH automatic_tax and tax_id_collection
# (collecting a buyer's GST/HST number is pointless while we cannot charge tax).
#
# The threshold is a ROLLING four-consecutive-calendar-quarter window, and
# exceeding $30k inside a single quarter ends small-supplier status immediately.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
# Public API base URL — baked into the Next.js build at compile time
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── CI / Deployment ─────────────────────────────────────────────────────────
# GitHub container registry owner — set automatically in CI, override locally
GITHUB_REPOSITORY_OWNER=boilerhaus
# Git SHA used to pin image tags (compose ${GIT_SHA}) — defaults to "latest" if
# unset. CI also bakes the commit SHA into the API image as a build arg, which
# the app reports at /health so the deploy workflow can confirm the live build.
GIT_SHA=latest
